{
  "type": "module",
  "name": "@airlib/solid",
  "version": "2.2.0",
  "description": "Solid bindings for Anchor reactive state management",
  "keywords": [
    "state",
    "management",
    "reactive",
    "observable",
    "solid"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./client": {
      "solid": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./common": {
      "solid": "./src/common/index.ts",
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./core": {
      "solid": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./reactive": {
      "solid": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./router": {
      "solid": "./src/router/index.ts",
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./server": {
      "solid": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./ssr": {
      "solid": "./src/ssr/index.ts",
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    },
    "./storage": {
      "solid": "./src/storage/index.ts",
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./utils": {
      "solid": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js"
    },
    "./mdx": {
      "solid": "./src/mdx/index.ts",
      "types": "./dist/mdx/index.d.ts",
      "import": "./dist/mdx/index.js"
    },
    "./mdx/*": {
      "solid": "./src/mdx/*.tsx",
      "types": "./dist/mdx/*.d.ts",
      "import": "./dist/mdx/*.js"
    },
    "./mdx/*.css": "./src/mdx/*.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild-raw-plugin": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "solid-js": "catalog:lib",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-solid": "catalog:lib",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@airlib/core": "workspace:*",
    "@airlib/router": "workspace:*",
    "@airlib/ssr": "workspace:*",
    "@airlib/storage": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "catalog:lib"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "prepublish": "bun run format && bun run build",
    "format": "biome format --write",
    "test": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage"
  }
}