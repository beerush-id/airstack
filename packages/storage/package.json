{
  "type": "module",
  "name": "@airlib/storage",
  "version": "2.2.0",
  "description": "Persistent storage solutions for Anchor state management",
  "keywords": ["state", "management", "reactive", "observable", "storage"],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    }
  },
  "files": ["dist"],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@airlib/core": "workspace:*"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "format": "biome format --write",
    "prepublish": "bun run format && bun run build",
    "test": "rimraf coverage && vitest --run",
    "test:run": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage"
  },
  "optionalDependencies": {
    "zod": "catalog:lib"
  }
}
