{
  "type": "module",
  "name": "@airlib/ssr",
  "version": "2.2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "directories": {
    "dist": "dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@irpclib/http": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@airlib/core": "workspace:*",
    "@airlib/router": "workspace:*"
  },
  "optionalDependencies": {
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/ws": "workspace:*"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "format": "biome format --write",
    "test": "rimraf coverage && vitest --run",
    "test:run": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage",
    "prepublish": "bun run format && bun run build"
  },
  "license": "MIT"
}
