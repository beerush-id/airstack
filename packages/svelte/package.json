{
  "name": "@airlib/svelte",
  "version": "2.2.0",
  "description": "Svelte bindings for Anchor reactive state management",
  "keywords": ["state", "management", "reactive", "observable", "svelte"],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "type": "module",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "svelte": "./dist/common/index.js",
      "import": "./dist/common/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "svelte": "./dist/core/index.js",
      "import": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "svelte": "./dist/client/index.js",
      "import": "./dist/client/index.js"
    },
    "./reactive": {
      "types": "./dist/client/index.d.ts",
      "svelte": "./dist/client/index.js",
      "import": "./dist/client/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "svelte": "./dist/storage/index.js",
      "import": "./dist/storage/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "svelte": "./dist/utils/index.js",
      "import": "./dist/utils/index.js"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "import": "./dist/timeline/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js"
    }
  },
  "directories": {
    "dist": "./dist"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:lib",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@airlib/core": "workspace:*",
    "@airlib/storage": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "catalog:lib"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "prepublish": "bun run format && bun run build",
    "format": "biome format --write",
    "test": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage"
  },
  "optionalDependencies": {
    "zod": "catalog:lib"
  }
}
