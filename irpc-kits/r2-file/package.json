{
  "name": "@irpclib/r2-file",
  "version": "2.2.0",
  "type": "module",
  "description": "High-performance isomorphic natural file system toolkit for Cloudflare Workers, R2, and D1",
  "keywords": ["cloudflare", "workers", "r2", "d1", "fs", "filesystem", "irpc", "storage", "streaming"],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./path": {
      "types": "./dist/utils/path.d.ts",
      "import": "./dist/utils/path.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./drivers/r2": {
      "types": "./dist/drivers/r2/index.d.ts",
      "import": "./dist/drivers/r2/index.js"
    },
    "./drivers/d1": {
      "types": "./dist/drivers/d1/index.d.ts",
      "import": "./dist/drivers/d1/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./constructor": {
      "types": "./dist/constructor.d.ts",
      "import": "./dist/constructor.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": ["dist"],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "format": "biome format --write",
    "test": "rimraf coverage && vitest --run",
    "test:run": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage",
    "prepublish": "bun run format && bun run build"
  },
  "dependencies": {
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "catalog:",
    "@types/bun": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
