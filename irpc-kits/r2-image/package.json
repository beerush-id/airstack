{
  "name": "@irpclib/r2-image",
  "version": "2.2.0",
  "type": "module",
  "description": "High-performance image delivery and isomorphic uploads for Cloudflare Workers, R2, and Containers",
  "keywords": [
    "cloudflare",
    "workers",
    "r2",
    "image",
    "resize",
    "irpc",
    "container"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./constructor": {
      "types": "./dist/constructor.d.ts",
      "import": "./dist/constructor.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./container": {
      "types": "./dist/container.d.ts",
      "import": "./dist/container.js"
    }
  },
  "bin": "./bin/index.js",
  "files": [
    "dist",
    "bin"
  ],
  "directories": {
    "dist": "./dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/container.ts",
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "test": "rimraf coverage && vitest --run",
    "test:run": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage",
    "prepublish": "bun run build"
  },
  "dependencies": {
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@napi-rs/image": "^1.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/bun": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}