{
  "type": "module",
  "name": "@airlib/solid-form",
  "version": "2.1.0",
  "description": "Reactive and declarative SolidJS form components built on AirLib. Typed forms, field validation, cross-field matching, and array fields with fine-grained reactivity.",
  "keywords": [
    "solid",
    "solidjs",
    "form",
    "validation",
    "zod",
    "reactive",
    "airlib",
    "anchor",
    "typescript"
  ],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/airstack.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/airstack/issues"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "directories": {
    "dist": "dist",
    "src": "src"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "solid-js": "catalog:lib",
    "tsdown": "catalog:",
    "unplugin-solid": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@airlib/form": "workspace:*"
  },
  "peerDependencies": {
    "@airlib/solid": "workspace:*",
    "solid-js": "catalog:lib",
    "typescript": "catalog:lib",
    "zod": "catalog:lib"
  },
  "scripts": {
    "dev": "rimraf dist && tsdown --watch ./src",
    "clean": "rimraf dist",
    "build": "bun run clean && tsdown && publint",
    "prepublish": "bun run format && bun run build",
    "format": "biome format --write",
    "test:run": "rimraf coverage && vitest --run",
    "test:preview": "rimraf coverage && vitest --run && vite preview --outDir coverage"
  },
  "license": "MIT"
}