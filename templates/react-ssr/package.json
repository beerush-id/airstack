{
  "name": "my-anchor-app",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "description": "AirLib for React — Vite SSR Starter (SSR Only)",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr --outDir dist/server",
    "start": "NODE_ENV=production bun run server/bun.js",
    "start:node": "NODE_ENV=production node server/node.js",
    "start:deno": "NODE_ENV=production deno run --allow-net --allow-read --allow-env server/deno.js",
    "lint": "biome check"
  },
  "dependencies": {
    "@airlib/react": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "optionalDependencies": {
    "@hono/node-server": "^1.13.8"
  },
  "devDependencies": {
    "@airlib/vite": "workspace:*",
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}