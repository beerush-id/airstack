{
  "name": "my-irpc-api",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "description": "Standalone IRPC Isomorphic API Starter",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "start": "NODE_ENV=production bun run server/bun.js",
    "start:node": "NODE_ENV=production node server/node.js",
    "start:deno": "NODE_ENV=production deno run --allow-net --allow-read --allow-env server/deno.js",
    "lint": "biome check"
  },
  "dependencies": {
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/ws": "workspace:*"
  },
  "optionalDependencies": {
    "@hono/node-server": "^1.13.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "tsdown": "^0.15.9"
  }
}
