{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "airstack",
  "main": "./server/worker.js",
  "compatibility_date": "2025-06-10",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "air-web-asset"
    }
  ],
  "env": {
    "production": {
      "containers": [
        {
          "class_name": "ImageResizer",
          "image": "ghcr.io/beerush-id/r2-image:latest",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "DURABLE_LINK", "class_name": "AirDurableLink" },
          { "name": "RESIZER", "class_name": "ImageResizer" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AirDurableLink", "ImageResizer"] }]
    }
  }
}
