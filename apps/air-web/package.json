{
  "name": "air-web",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr --outDir dist/server",
    "start": "NODE_ENV=production bun run server/bun.js",
    "start:node": "NODE_ENV=production node server/node.js",
    "start:deno": "NODE_ENV=production deno run --allow-net --allow-read --allow-env server/deno.js",
    "lint": "oxlint",
    "test": "vitest --run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@airlib/aria": "workspace:*",
    "@airlib/react": "workspace:*",
    "@airlib/react-form": "workspace:*",
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/r2-file": "workspace:*",
    "@irpclib/r2-image": "workspace:*",
    "@irpclib/ws": "workspace:*",
    "minisearch": "catalog:app",
    "react": "catalog:app",
    "react-dom": "catalog:app"
  },
  "devDependencies": {
    "@airlib/vite": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@tailwindcss/vite": "catalog:app",
    "@types/node": "catalog:",
    "@types/react": "catalog:lib",
    "@types/react-dom": "catalog:lib",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:app",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}