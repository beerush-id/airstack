{
  "name": "airlib",
  "type": "module",
  "version": "2.2.0",
  "description": "Reactive State Management for Javascript",
  "scripts": {
    "dev": "mpkg run dev -f packages/* irpclib/* ui-kits/* irpc-kits/* -e create-airlib headless",
    "dev:core": "bpkg run dev -f packages/core",
    "dev:next": "bpkg run dev -f apps/next",
    "dev:react": "bpkg run dev -f apps/react",
    "dev:solid": "bpkg run dev -f apps/solid",
    "dev:svelte": "bpkg run dev -f apps/svelte",
    "dev:vue": "bpkg run dev -f apps/vue",
    "build:packages": "bpkg run build -f packages/*",
    "build:next": "bpkg run build -f apps/next --sequential",
    "build:react": "bpkg run build -f apps/react --sequential",
    "build": "bpkg run build -f packages/* irpclib/* ui-kits/* irpc-kits/* --sequential",
    "prepublish": "bun run version:sync && bpkg run prepublish -f packages/* irpclib/* ui-kits/* irpc-kits/* --sequential",
    "version:sync": "bun scripts/version-sync.ts",
    "version:revert": "bun scripts/version-sync.ts --revert",
    "format": "bpkg run format -f apps/* packages/* irpclib/* ui-kits/* irpc-kits/* --sequential && git add --renormalize .",
    "lint": "bpkg run lint",
    "test": "rimraf docs/.vitepress/dist/coverage && vitest --run",
    "test:all": "rimraf docs/.vitepress/dist/coverage && vitest --run",
    "test:preview": "rimraf docs/.vitepress/dist/coverage && vitest --run && vite preview --outDir docs/.vitepress/dist/coverage",
    "docs:dev": "vitepress dev docs --port 6611",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 5611"
  },
  "devDependencies": {
    "@airlib/react": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@irpclib/irpc": "workspace:*",
    "@tailwindcss/browser": "catalog:",
    "@tailwindcss/language-server": "catalog:",
    "@types/bun": "catalog:",
    "@types/markdown-it-container": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:app",
    "@types/react-dom": "catalog:app",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "lint-staged": "catalog:",
    "lucide-react": "catalog:app",
    "markdown-it-container": "catalog:",
    "monopkg": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:app",
    "react-dom": "catalog:app",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitepress-plugin-sandpack": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.2"
  },
  "packageManager": "bun@1.3.2",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "irpclib/*", "demos/*", "ui-kits/*", "irpc-kits/*", "private/*"],
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://github.com/beerush-id/airstack",
  "license": "MIT",
  "repository": {
